<!DOCTYPE html> <html lang="en"> <head> <style> #grain-overlay { position: fixed; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; z-index: 99; } </style> </head> <body> <canvas id="grain-overlay"></canvas> <script type="importmap"> { "imports": { "three": "https://esm.sh/three@0.160.0" } } </script> <script type="module"> import * as THREE from 'three'; const canvas = document.getElementById('grain-overlay'); const renderer = new THREE.WebGLRenderer({ canvas, alpha: true }); renderer.setSize(window.innerWidth, window.innerHeight); const scene = new THREE.Scene(); const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1); const material = new THREE.ShaderMaterial({ transparent: true, uniforms: { time: { value: 0 }, intensity: { value: 0.0825 } }, vertexShader: ` varying vec2 vUv; void main() { vUv = uv; gl_Position = vec4(position, 1.0); } `, fragmentShader: ` uniform float time; uniform float intensity; varying vec2 vUv; float random(vec3 st) { return fract(sin(dot(st, vec3(12))) * 43758.5453); } void main() { vec2 st = vUv * 2.0; float noise = random(vec3(st, fract(time * 123.456))); gl_FragColor = vec4(vec3(noise), intensity); } ` }); const quad = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), material); scene.add(quad); function animate() { renderer.setSize(window.innerWidth, window.innerHeight); material.uniforms.time.value = performance.now() * 0.0001; renderer.render(scene, camera); requestAnimationFrame(animate); } animate(); window.addEventListener('resize', () => { renderer.setSize(window.innerWidth, window.innerHeight); }); </script> </body> </html>
